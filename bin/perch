#!/usr/bin/env bash
# Operator wrapper around podman-compose for a perch install.
#   ./bin/perch up | down | restart [service] | ps | logs [service] | build
#   ./bin/perch status               a summary of everything, in one screen
#   ./bin/perch token [name]         mint an API token for Tern
#   ./bin/perch console-password     set (or clear) the console password
#   ./bin/perch pull-model <name>    download a language model
#   ./bin/perch fetch <model>        download an image, video or audio model
#   ./bin/perch models               what is installed and what is loaded
#   ./bin/perch refresh              recreate containers whose image has changed
#   ./bin/perch connections          list them, with state
#   ./bin/perch tunnel <start|stop|restart|status|logs|enable|disable> <id>
#   ./bin/perch boot <on|off>        start perch when this machine boots
#   ./bin/perch hostd-install        (re)install the host helper unit
#   ./bin/perch doctor               check the things that usually go wrong
#   ./bin/perch update               pull, rebuild and restart
#   ./bin/perch compose <args>       raw podman-compose with the right files
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
[ -f .env ] || { echo "No .env yet; run sudo ./install.sh first." >&2; exit 1; }
# .env is root-only (mode 600), so become root before reading it.
# Become root, but not with the invoking user's home.
#
# `sudo -E` alone preserves HOME, and podman reads ~/.config/containers/storage.conf
# to decide which storage it addresses. On a machine where the user has one —
# common, and the default on some desktops — root's podman then operates on
# that user's *rootless* store instead of the root store the installer built
# the containers in. Nothing errors: `up` cheerfully builds a second, parallel
# stack, `logs` and `status` report on containers that are not the ones
# serving, and the two sets fight over the same ports.
#
# -E is kept, because PERCH_* overrides passed on the command line should
# survive. HOME and the XDG variables that redirect container storage do not.
if [ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null; then
  exec sudo -E env -u XDG_RUNTIME_DIR -u XDG_DATA_HOME -u XDG_CONFIG_HOME HOME=/root "$0" "$@"
fi
# shellcheck disable=SC1091
set -a; . ./.env; set +a
export COMPOSE_FILE="${COMPOSE_FILE:-compose.yml}"

if command -v podman-compose >/dev/null 2>&1; then COMPOSE_CMD="podman-compose"
else COMPOSE_CMD="podman compose"; fi
compose() { $COMPOSE_CMD --env-file "$ROOT/.env" "$@"; }

# Which services are running an image that is no longer what their tag points
# at — the question `compose up -d` does not ask.
#
# podman-compose decides whether to recreate a container from a hash of the
# service's *configuration*: its image name, environment, ports. A rebuilt or
# re-pulled image under the same tag changes none of those, so build-then-up
# leaves the old container running and reports success. That is the worst
# possible outcome of an update, because every line of output says it worked.
#
# `.Image` is the tag the container was created from and `.ImageID` is what it
# is actually running; if the tag now resolves to something else, the container
# is behind.
stale_services() {
  local name svc ref running latest out=""
  # Names from `ps`, everything else from `inspect`. `podman ps --format` will
  # take a template that indexes .Labels and then quietly produce empty fields
  # for it — which here would mean reporting every container as current, the
  # exact failure this function exists to prevent.
  while read -r name; do
    [ -n "$name" ] || continue
    IFS='|' read -r svc ref running <<<"$(podman inspect "$name" \
      --format '{{index .Config.Labels "io.podman.compose.service"}}|{{.ImageName}}|{{.Image}}' 2>/dev/null)"
    [ -n "$svc" ] && [ -n "$ref" ] && [ -n "$running" ] || continue
    latest=$(podman image inspect "$ref" --format '{{.Id}}' 2>/dev/null || echo "$running")
    [ "$latest" = "$running" ] && continue
    out="$out $svc"
  done < <(podman ps -a --filter "label=io.podman.compose.project=$(basename "$ROOT")" \
             --format '{{.Names}}' 2>/dev/null)
  printf '%s' "$out"
}

CONSOLE="http://127.0.0.1:${PERCH_CONSOLE_PORT:-8099}"
ENDPOINT="http://127.0.0.1:${PERCH_PROXY_PORT:-11434}"

if [ -t 1 ]; then B=$'\e[1m'; D=$'\e[2m'; G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; C=$'\e[36m'; N=$'\e[0m'
else B=; D=; G=; Y=; R=; C=; N=; fi
ok()   { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
bad()  { printf '  %s✗%s %s\n' "$R" "$N" "$*"; }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$*"; }
note() { printf '  %s%s%s\n' "$D" "$*" "$N"; }
head_() { printf '\n%s%s%s\n' "$B" "$*" "$N"; }

# A field out of a JSON object, without needing jq installed.
jget() { sed -n "s/.*\"$1\":\"\\([^\"]*\\)\".*/\\1/p" | head -1; }
jnum() { sed -n "s/.*\"$1\":\\([0-9.]*\\).*/\\1/p" | head -1; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  up)        compose up -d "$@" ;;
  down)      compose down "$@" ;;
  restart)   compose restart "$@" ;;
  ps)        compose ps "$@" ;;
  build)     compose build perch "$@" ;;
  compose)   compose "$@" ;;
  logs)
    if [ -t 1 ]; then compose logs -f --tail=200 "$@"; else compose logs --tail=200 "$@"; fi ;;

  token)
    name="${1:-Tern}"
    out=$(curl -fsS --max-time 10 -X POST "$CONSOLE/api/tokens" -H 'Content-Type: application/json' \
      -d "{\"name\":\"$name\",\"scopes\":[\"use\",\"manage\"]}") || { bad "the console is not answering at $CONSOLE"; exit 1; }
    tok=$(printf '%s' "$out" | jget token)
    printf '\n  %s%s%s\n\n' "$C" "$tok" "$N"
    note "shown once — perch keeps a hash, not the token." ;;

  console-password)
    printf 'A password lets you open the console from another machine on your own\n'
    printf 'network. Leave it blank to clear it, which restricts the console to this\n'
    printf 'machine only.\n\n'
    read -r -s -p "  New console password: " pw; echo
    if [ -z "$pw" ]; then
      curl -fsS -X POST "$CONSOLE/api/console-password" -H 'Content-Type: application/json' -d '{"password":null}' >/dev/null \
        && ok "password cleared; the console now answers only on this machine"
    else
      [ "${#pw}" -ge 10 ] || { bad "use at least 10 characters."; exit 1; }
      read -r -s -p "  Again: " pw2; echo
      [ "$pw" = "$pw2" ] || { bad "those did not match."; exit 1; }
      # Sent over loopback to the console, which stores only a scrypt hash.
      python3 -c 'import json,sys;print(json.dumps({"password":sys.argv[1]}))' "$pw" \
        | curl -fsS -X POST "$CONSOLE/api/console-password" -H 'Content-Type: application/json' -d @- >/dev/null \
        && ok "password set"
    fi ;;

  pull-model)
    [ $# -ge 1 ] || { bad "which model? e.g. ./bin/perch pull-model qwen3.5:9b"; exit 1; }
    compose exec -T ollama ollama pull "$1" ;;

  # Recreate whatever is behind its image, and nothing else. Safe to run at any
  # time: with everything current it stops one command short of touching a
  # single container.
  refresh)
    stale="$(stale_services)"
    if [ -z "$stale" ]; then
      ok "every container is running its current image"
      exit 0
    fi
    note "a newer image is on disk for:$stale"
    # shellcheck disable=SC2086
    compose up -d --force-recreate $stale || true
    # Asked again rather than assumed. A stop that is refused — by a stuck
    # container, or by a security policy that will not let this process signal
    # it — leaves podman-compose creating a replacement that cannot bind the
    # port, and the old one still serving. Reporting success there is how an
    # update silently does nothing.
    still="$(stale_services)"
    if [ -n "$still" ]; then
      bad "still running the old image:$still"
      note "podman could not replace the container. Check what is holding it:"
      note "  podman ps -a --filter name=perch"
      note "  journalctl -k -n 20   # a denied signal shows up here"
      exit 1
    fi
    ok "recreated:$stale" ;;

  models)
    head_ "Installed"
    compose exec -T ollama ollama list
    head_ "In memory"
    compose exec -T ollama ollama ps ;;

  # Image, video and audio models, which are files rather than tags.
  #
  # Ollama fetches its own; these backends do not. They read a directory when
  # they start and have no API for putting anything in it, so somebody has to
  # write the file — and it cannot be the perch container, which deliberately
  # has no access to podman or to another container's storage.
  #
  # The catalogue comes from the console rather than living here as well. Two
  # lists of URLs would disagree the first time one of them was edited, and the
  # one that was wrong would be the one that downloads seventeen gigabytes.
  fetch)
    [ $# -ge 1 ] || {
      bad "which model? The console's Models page lists them, or:"
      curl -fsS --max-time 10 "$CONSOLE/api/media" 2>/dev/null \
        | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for m in d["models"]:
    if m.get("bundled"): continue
    print("    %-18s %-22s %5.1f GB  %s" % (m["id"], m["name"], m["sizeBytes"]/1e9, m["family"]))'
      exit 2
    }
    model="$1"
    spec=$(curl -fsS --max-time 15 "$CONSOLE/api/media/model?id=$model" 2>/dev/null) || {
      bad "the console did not answer for '$model'"
      note "either it is not running (./bin/perch up), there is no such model"
      note "(./bin/perch fetch with no arguments lists them), or a console password is"
      note "set — the console API needs a session, which this script has no way to hold."
      note "In that case the Models page shows each file's address and where it goes."
      exit 1
    }
    # The volume, then everything that has to go in it.
    #
    # Parsed properly rather than with the sed helpers above, because this
    # decides where several gigabytes are written. An empty name would reach
    # `podman volume inspect` as no argument at all, which inspects *every*
    # volume and answers with whichever comes first — a plausible path, into
    # the wrong container's storage.
    store=$(printf '%s' "$spec" | python3 -c 'import json,sys
d = json.load(sys.stdin)
print("%s\t%s" % (d.get("volume", ""), d.get("subdir", "")))')
    IFS=$'\t' read -r vol sub <<<"$store"
    [ -n "$vol" ] || { bad "the console did not say which volume '$model' belongs in"; exit 1; }
    # podman-compose prefixes volume names with the project, and the project is
    # the directory this is installed in, so both shapes are tried.
    mount=""
    for candidate in "$(basename "$ROOT")_$vol" "perch_$vol" "$vol"; do
      mount=$(podman volume inspect "$candidate" --format '{{.Mountpoint}}' 2>/dev/null) && [ -n "$mount" ] && break
      mount=""
    done
    if [ -z "$mount" ]; then
      bad "no podman volume for $vol yet"
      note "it is created the first time that service starts: ./bin/perch up"
      exit 1
    fi
    dest_root="$mount${sub:+/$sub}"
    # Fed by process substitution rather than a pipe, so a failed download can
    # stop the script: the loop body of a pipeline runs in a subshell, where
    # exiting would only end the subshell and let the success message print.
    while IFS=$'\t' read -r url dest bytes; do
        target="$dest_root/$dest"
        mkdir -p "$(dirname "$target")"
        if [ -f "$target" ]; then
          have=$(stat -c %s "$target" 2>/dev/null || echo 0)
          if [ "$have" -ge "$bytes" ]; then ok "$(basename "$dest") is already here"; continue; fi
          note "$(basename "$dest") is incomplete, resuming"
        fi
        printf '  %sfetching%s %s (%s GB)\n' "$D" "$N" "$dest" "$(awk -v b="$bytes" 'BEGIN{printf "%.1f", b/1e9}')"
        # --continue-at resumes a partial file, so an interrupted 17 GB
        # download is not started again from nothing.
        if curl -fL --continue-at - --progress-bar -o "$target" "$url"; then
          ok "$dest"
        else
          bad "$dest failed — run this again to resume"
          exit 1
        fi
      done < <(printf '%s' "$spec" | python3 -c 'import json,sys
d = json.load(sys.stdin)
for f in d["model"]["files"]:
    print("%s\t%s\t%d" % (f["url"], f["dest"], f["bytes"]))')
    # The file has to be readable by the container, which runs as its own user.
    chmod -R a+rX "$dest_root" 2>/dev/null || true
    ok "done. The service picks up a new file when it is recreated:"
    note "./bin/perch compose up -d --force-recreate" ;;

  connections)
    printf '\n%s%-20s %-10s %-10s %s%s\n' "$B" "CONNECTION" "TUNNEL" "AT BOOT" "UNIT" "$N"
    found=0
    for f in /etc/systemd/system/perch-tunnel-*.service; do
      [ -e "$f" ] || continue
      found=1
      u="$(basename "$f")"; cid="${u#perch-tunnel-}"; cid="${cid%.service}"
      printf '  %-20s %-10s %-10s %s\n' "$cid" \
        "$(systemctl is-active "$u" 2>/dev/null || echo unknown)" \
        "$(systemctl is-enabled "$u" 2>/dev/null || echo unknown)" "$u"
    done
    [ "$found" = 0 ] && note "none yet — add one in the console, under Connect"
    echo ;;

  tunnel)
    action="${1:-status}"; cid="${2:-}"
    # Every connection has its own unit, so an action needs to know which. With
    # exactly one there is no ambiguity, so it is filled in.
    if [ -z "$cid" ]; then
      mapfile -t units < <(ls -1 /etc/systemd/system/perch-tunnel-*.service 2>/dev/null || true)
      if [ "${#units[@]}" -eq 1 ]; then
        cid="$(basename "${units[0]}")"; cid="${cid#perch-tunnel-}"; cid="${cid%.service}"
      elif [ "${#units[@]}" -eq 0 ]; then
        bad "no connections yet. Add one in the console, under Connect."; exit 1
      else
        bad "which connection? ./bin/perch connections lists them."; exit 2
      fi
    fi
    unit="perch-tunnel-${cid}.service"
    [ -f "/etc/systemd/system/$unit" ] || { bad "no connection called '$cid'. ./bin/perch connections lists them."; exit 1; }
    case "$action" in
      start|stop|restart)  systemctl "$action" "$unit" && ok "$cid ${action}ed" ;;
      enable)              systemctl enable --now "$unit" && ok "$cid will start at boot" ;;
      disable)             systemctl disable --now "$unit" && ok "$cid will not start at boot" ;;
      logs)                journalctl -u "$unit" -n 100 --no-pager ;;
      status)              systemctl status "$unit" --no-pager || true ;;
      *) bad "start, stop, restart, enable, disable, logs or status"; exit 2 ;;
    esac ;;

  boot)
    case "${1:-}" in
      on)  systemctl enable perch.service >/dev/null && ok "perch will start at boot" ;;
      off) systemctl disable perch.service >/dev/null && ok "perch will not start at boot" ;;
      *)   printf '  %s\n' "$(systemctl is-enabled perch.service 2>/dev/null || echo 'not installed')" ;;
    esac ;;

  hostd-install)
    sed -e "s|__PERCH_DIR__|$ROOT|g" -e "s|__STATE_DIR__|${PERCH_STATE_DIR:-/var/lib/perch}|g" \
        -e "s|__PERCH_UID__|1000|g" -e "s|__PERCH_GID__|1000|g" \
        deploy/perch-hostd.service.tmpl > /etc/systemd/system/perch-hostd.service
    systemctl daemon-reload
    systemctl enable --now perch-hostd.service
    ok "the host helper is installed and running" ;;

  status)
    head_ "perch"
    if curl -fsS --max-time 3 "$ENDPOINT/healthz" >/dev/null 2>&1; then ok "model endpoint answering on $ENDPOINT"
    else bad "model endpoint is not answering on $ENDPOINT"; fi
    if curl -fsS --max-time 3 "$CONSOLE/api/session" >/dev/null 2>&1; then ok "console on $CONSOLE"
    else bad "console is not answering on $CONSOLE"; fi

    head_ "Containers"
    compose ps 2>/dev/null || warn "podman-compose could not list them"

    head_ "Connections"
    any=0
    for f in /etc/systemd/system/perch-tunnel-*.service; do
      [ -e "$f" ] || continue
      any=1
      u="$(basename "$f")"; cid="${u#perch-tunnel-}"; cid="${cid%.service}"
      a=$(systemctl is-active "$u" 2>/dev/null || true)
      e=$(systemctl is-enabled "$u" 2>/dev/null || true)
      if [ "$a" = active ]; then ok "$cid: running$([ "$e" = enabled ] && echo ', starts at boot')"
      else bad "$cid: $a"; fi
    done
    [ "$any" = 0 ] && note "no connections yet — open the console and go to Connect"

    head_ "Host helper"
    if systemctl is-active perch-hostd.service >/dev/null 2>&1; then ok "running"
    else bad "not running (./bin/perch hostd-install)"; fi ;;

  doctor)
    fail=0
    head_ "The things that usually go wrong"

    # Which podman this is talking to, before anything that depends on the
    # answer. A root podman that picked up a storage.conf from a user's home
    # addresses that user's rootless store — where the containers the
    # installer created are not. Every check below would then be reporting on
    # containers that are not the ones serving, and every fix would be applied
    # to the wrong copy.
    graph=$(podman info --format '{{.Store.GraphRoot}}' 2>/dev/null || echo "")
    if [ -n "$graph" ] && [ "$graph" != "/var/lib/containers/storage" ]; then
      bad "this podman is using $graph, not root's /var/lib/containers/storage"
      note "a storage.conf under someone's home has been picked up, so the containers"
      note "the installer created are invisible from here — and a second, parallel set"
      note "can be built without either being obviously wrong. Check HOME and XDG_*."
      fail=1
    else
      ok "podman is using root's own storage"
    fi

    if curl -fsS --max-time 3 "$ENDPOINT/healthz" >/dev/null 2>&1; then ok "the model endpoint is listening"
    else bad "the model endpoint is not listening — the containers may be down (./bin/perch up)"; fail=1; fi

    if compose exec -T ollama ollama list >/dev/null 2>&1; then ok "Ollama answers"
    else bad "Ollama is not answering (./bin/perch logs ollama)"; fail=1; fi

    if compose exec -T ollama ollama list 2>/dev/null | tail -n +2 | grep -q .; then ok "at least one model is downloaded"
    else warn "no models yet — download one in the console, or ./bin/perch pull-model qwen3.5:9b"; fi

    keys=$(find "${PERCH_STATE_DIR:-/var/lib/perch}/ssh" -name id_ed25519 2>/dev/null | wc -l)
    if [ "$keys" -gt 0 ]; then
      ok "$keys connection key(s) present"
      # The console runs in a container as a different uid from the account
      # that owns the keys. If it cannot traverse to a public key, adding a
      # connection fails at the last step with nothing obviously wrong.
      pub=$(find "${PERCH_STATE_DIR:-/var/lib/perch}/ssh" -name 'id_ed25519.pub' 2>/dev/null | head -1)
      if [ -n "$pub" ]; then
        if compose exec -T perch sh -c "cat '$pub' >/dev/null 2>&1"; then ok "the console can read the public keys"
        else bad "the console cannot read the public keys — adding a connection will fail"
             note "sudo chmod 711 ${PERCH_STATE_DIR:-/var/lib/perch}/ssh ${PERCH_STATE_DIR:-/var/lib/perch}/ssh/*"
             fail=1; fi
        if compose exec -T perch sh -c "cat '${pub%.pub}' >/dev/null 2>&1"; then
          bad "the console can read a PRIVATE key — it should not be able to"; fail=1
        else ok "private keys are not readable by the console"; fi
      fi
    else warn "no connection keys yet — add a connection in the console under Connect"; fi

    if systemctl is-active perch-hostd.service >/dev/null 2>&1; then ok "the host helper is running"
    else bad "the host helper is not running, so the console cannot see the GPU or drive the tunnel"; fail=1; fi

    any=0
    for f in /etc/systemd/system/perch-tunnel-*.service; do
      [ -e "$f" ] || continue
      any=1
      u="$(basename "$f")"; cid="${u#perch-tunnel-}"; cid="${cid%.service}"
      if systemctl is-active "$u" >/dev/null 2>&1; then
        ok "$cid is up"
      else
        bad "$cid is configured but not running"
        note "last few lines:"
        journalctl -u "$u" -n 5 --no-pager 2>/dev/null | sed 's/^/    /'
        fail=1
      fi
    done
    [ "$any" = 0 ] && warn "no connections configured yet"

    # A GPU that is present but not visible to the container is the single
    # most common "why is this so slow" cause.
    #
    # Checked by looking for the device node rather than by running nvidia-smi
    # in there. nvidia-smi is only present when the container toolkit injected
    # it; with the device-passthrough setup the GPU works perfectly well and
    # nvidia-smi does not exist, so asking for it reports a fault on a machine
    # that is fine — and then advises installing a toolkit it does not need.
    if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
      if compose exec -T ollama test -e /dev/nvidia0 2>/dev/null; then
        ok "Ollama can reach the GPU"
        # Where a model is loaded, ollama itself says whether it is on the
        # card, which beats grepping the log: the CUDA line is printed once at
        # startup, so finding it means reading the whole log — slow enough on a
        # busy install to make doctor look hung.
        proc=$(compose exec -T ollama ollama ps 2>/dev/null | awk 'NR==2 {print $4, $5}')
        case "$proc" in
          *GPU*) ok "the loaded model is on the GPU ($proc)" ;;
          *CPU*) bad "a model is loaded but running on the CPU ($proc)"; fail=1 ;;
          *)     note "no model loaded, so nothing to report on placement" ;;
        esac
      else
        bad "this machine has an NVIDIA GPU but the container cannot see it — the model is running on the CPU"
        note "re-run sudo ./install.sh: it will pass the devices through, or use the container toolkit if you have it"
        fail=1
      fi
    fi

    echo
    [ "$fail" = 0 ] && ok "nothing obviously wrong" || warn "see above"
    exit "$fail" ;;

  update)  exec "$ROOT/update.sh" ;;

  help|--help|-h|*)
    # The header comment, however long it grows: printed until the first line
    # that is not a comment, rather than up to a line number that goes stale
    # the next time a command is added.
    awk 'NR>1 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$0" ;;
esac
