# A copy of what install.sh writes. You do not normally edit this by hand:
# re-run ./install.sh and it walks through every value again, keeping what you
# chose last time as the default.

# Where the console and the model endpoint listen. Both bound to 127.0.0.1 in
# compose.yml — the SSH tunnel picks the endpoint up from loopback, so neither
# ever needs to exist on another interface.
PERCH_CONSOLE_PORT=8099
PERCH_CONSOLE_BIND=127.0.0.1
PERCH_PROXY_PORT=11434
PERCH_PROXY_BIND=127.0.0.1
PERCH_STATE_DIR=/var/lib/perch

# The other model servers. Each is off unless its overlay is in COMPOSE_FILE,
# and each gets its own port because a transcriber is a different server from
# a language model — one allowlist per API is the whole point.
#
# The number is the one that service is conventionally found on, so a client
# already written against a local whisper.cpp or ComfyUI needs no new port.
# These are perch's front doors rather than the backends themselves — the
# backend containers publish nothing and are reached over the compose network,
# where they keep these same numbers.
PERCH_VOICE_PORT=8080
PERCH_VIDEO_PORT=8188
PERCH_AUDIO_PORT=8880

# Which services listen at all, comma separated. chat is always on.
# One of: chat,voice,video,audio — 'video' is images, video and music, which
# are one container because they are all diffusion graphs.
PERCH_SERVICES=chat

# The ports as published on the host, which are not always the ports perch
# listens on inside the container. compose maps host:container, so a machine
# that already had something on 8080 gets its dictation endpoint published
# somewhere else while the container carries on listening where it always did.
#
# The tunnel runs on the host, so it forwards from these, not from the listen
# ports. They match by default, which is exactly why getting this wrong would
# go unnoticed until somebody remapped a port.
PERCH_HOST_CHAT_PORT=11434
PERCH_HOST_VOICE_PORT=8080
PERCH_HOST_VIDEO_PORT=8188
PERCH_HOST_AUDIO_PORT=8880

# Where each backend actually is. In the shipped compose files these are
# sibling containers that publish no port of their own: the only way in is
# through perch, so there is no unauthenticated back door on the LAN.
PERCH_OLLAMA_URL=http://ollama:11434
PERCH_WHISPER_URL=http://whisper:8080
PERCH_COMFY_URL=http://comfy:8188
PERCH_TTS_URL=http://kokoro:8880

# How each service reaches ITS upstream, when that is not a direct connection.
# Empty is direct, which is the default and what a machine hosting its own
# models wants.
#
# A proxy URL rather than a "use Tor" switch: perch then holds no opinion about
# which port Tor listens on (9050 for the C daemon, 9150 for Arti, something
# else entirely in another container), and the same field covers a jump host or
# any other SOCKS proxy. Prefer socks5h:// over socks5:// — the h means the
# PROXY resolves the hostname, which is the only way an .onion address works
# and stops this machine's resolver being told which upstream is about to be
# contacted.
#
# Per service, because the four upstreams are four different servers: a chat
# model on a rented box across the internet and a whisper container one bridge
# away are not the same journey, and one setting for both would force an
# operator to route the near one the way the far one needs. The console can
# change any of these without a restart; these are just the starting values.
#
#   PERCH_CHAT_PROXY=socks5h://127.0.0.1:9150
PERCH_CHAT_PROXY=
PERCH_VOICE_PROXY=
PERCH_VIDEO_PROXY=
PERCH_AUDIO_PROXY=

# A backstop, not a scheduler: how many generations may be in flight at once.
# Comfortably above OLLAMA_NUM_PARALLEL; it exists to stop a runaway caller
# pinning the GPU, not to schedule work. Past it, perch answers 503 with
# Retry-After rather than holding the socket open.
PERCH_MAX_CONCURRENT=4

# A generation can legitimately take minutes on a slow box with a big model,
# so this is generous: it reaps sockets a dead client left behind, and is not
# a cap on thinking time. Milliseconds.
PERCH_UPSTREAM_IDLE_MS=900000

# Refuse absurd request bodies before reading them. A chat request carrying a
# long thread is tens of kilobytes, but a minute of dictation is a couple of
# megabytes and an img2img source can be larger again — 64 MB is room for
# those and still far below "someone is filling my disk".
PERCH_MAX_BODY_BYTES=67108864

# Wrong tokens from one address, before that address is refused outright for a
# while. With the tunnel the only caller is Tern, so a run of bad tokens means
# either a misconfigured Tern or something on the far box that should not be
# talking to us; both are worth stopping early. Milliseconds for the two
# windows.
PERCH_AUTH_FAIL_LIMIT=10
PERCH_AUTH_FAIL_WINDOW_MS=900000
PERCH_AUTH_BLOCK_MS=900000

# Model management (pull and delete) through the proxy. Convenient, and also
# the most destructive thing a leaked token could do — so it is a per-token
# scope and this is the master switch.
PERCH_ALLOW_MANAGE=true

# How many proxy requests the Activity page remembers. In memory only: perch
# keeps no record of what was asked or answered, and restarting forgets even
# this much. See docs/SECURITY.md.
PERCH_ACTIVITY_LIMIT=300

# Where the built console lives inside the image. Empty means the default
# location baked into the image; set it only when running the server outside
# a container.
PERCH_CLIENT_DIST=

PERCH_LOG_LEVEL=info
PERCH_VERSION=0.1.0

# Ollama reads these when it starts, so change them and restart.
# How many requests are answered at once. Each slot holds its own context
# window of KV cache, so this is a memory decision as much as a speed one.
OLLAMA_NUM_PARALLEL=2
# A language model and an embedding model, resident together. Ollama's default
# is three, which on a single-GPU box means two idle models hold the memory the
# one in use needs; one meant every meaning search evicted the chat model. A
# ceiling, not a reservation: a second model that will not fit is not kept.
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_FLASH_ATTENTION=1
# Halves what each slot's context costs at close to no quality cost. Needs
# flash attention. q4_0 halves it again and does cost quality; f16 is off.
OLLAMA_KV_CACHE_TYPE=q8_0
# Ollama's own queue once every slot is busy. Its default of 512 is deep
# enough that a loaded box looks like a hung spinner for minutes.
OLLAMA_MAX_QUEUE=32
OLLAMA_KEEP_ALIVE=10m

# The model install.sh downloaded, for reference. The console is where you
# change which one is in use.
AI_MODEL=gemma4:12b

# Compose overlays, colon separated. install.sh adds compose.gpu.yml for
# NVIDIA or compose.rocm.yml for AMD, and one per enabled service.
COMPOSE_FILE=compose.yml
