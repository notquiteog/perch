# A copy of what install.sh writes. You do not normally edit this by hand:
# re-run ./install.sh and it walks through every value again, keeping what you
# chose last time as the default.

# Where the console and the model endpoint listen. Both bound to 127.0.0.1 in
# compose.yml — the SSH tunnel picks the endpoint up from loopback, so neither
# ever needs to exist on another interface.
PERCH_CONSOLE_PORT=8099
PERCH_PROXY_PORT=11434
PERCH_STATE_DIR=/var/lib/perch

# A backstop, not a scheduler: how many generations may be in flight at once.
# Comfortably above OLLAMA_NUM_PARALLEL; it exists to stop a runaway caller
# pinning the GPU, not to schedule work.
PERCH_MAX_CONCURRENT=4
PERCH_LOG_LEVEL=info
PERCH_VERSION=0.1.0

# Ollama reads these when it starts, so change them and restart.
# How many requests are answered at once. Each slot holds its own context
# window of KV cache, so this is a memory decision as much as a speed one.
OLLAMA_NUM_PARALLEL=2
# One model resident at a time. Ollama's default is three, which on a
# single-GPU box means two idle models hold the memory the one in use needs.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=1
# Halves what each slot's context costs at close to no quality cost. Needs
# flash attention. q4_0 halves it again and does cost quality; f16 is off.
OLLAMA_KV_CACHE_TYPE=q8_0
# Ollama's own queue once every slot is busy. Its default of 512 is deep
# enough that a loaded box looks like a hung spinner for minutes.
OLLAMA_MAX_QUEUE=32
OLLAMA_KEEP_ALIVE=10m

# The model install.sh downloaded, for reference. The console is where you
# change which one is in use.
AI_MODEL=gemma4:12b

# Compose overlays, colon separated. install.sh adds compose.gpu.yml for
# NVIDIA or compose.rocm.yml for AMD.
COMPOSE_FILE=compose.yml
