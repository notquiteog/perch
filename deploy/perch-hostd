#!/usr/bin/env bash
# =============================================================================
# perch-hostd — the small piece of perch that runs on the host rather than in
# a container.
#
# It exists for two reasons the container cannot satisfy on its own:
#
#   1. Telemetry. The perch container does not have the GPU — Ollama does —
#      and inside a container /proc/meminfo and `df` describe the container,
#      not the machine. So the host reads the real numbers and publishes them.
#   2. Control. Starting and stopping containers, enabling them at boot and
#      driving the tunnel all mean talking to podman and systemd. Handing the
#      podman socket to the container would have been three lines of compose
#      and would also mean that a bug in the internet-facing proxy is root on
#      this machine. Instead the container asks for one of a fixed list of
#      actions, by name, and this script decides whether to do it.
#
# The channel is deliberately boring: files in a shared directory. perch drops
# a request, this loop picks it up, runs the matching action and writes the
# result back. No socket to secure, no RPC to get wrong, and every request is
# a file you can read while debugging.
#
# Actions are matched against a literal case list. Arguments are validated
# before use and never reach a shell unquoted. If an action is not in the list
# below, it cannot be performed, whatever the container asks for.
# =============================================================================
set -uo pipefail

PERCH_DIR="${PERCH_DIR:-/opt/perch}"
STATE_DIR="${PERCH_STATE_DIR:-/var/lib/perch}"
HOST_DIR="$STATE_DIR/host"
REQ_DIR="$HOST_DIR/requests"
RES_DIR="$HOST_DIR/results"
STATUS="$HOST_DIR/status.json"
INTERVAL="${PERCH_HOSTD_INTERVAL:-1}"
# The account the console container runs as, so it can write requests.
OWNER_UID="${PERCH_UID:-1000}"
OWNER_GID="${PERCH_GID:-1000}"
# The unprivileged account the tunnel unit runs as, so the key it needs can
# belong to it rather than to root.
TUNNEL_USER="${PERCH_TUNNEL_USER:-perch}"

mkdir -p "$REQ_DIR" "$RES_DIR"
chown "$OWNER_UID:$OWNER_GID" "$HOST_DIR" "$REQ_DIR" 2>/dev/null || true
chmod 755 "$HOST_DIR"; chmod 733 "$REQ_DIR"; chmod 755 "$RES_DIR"

log() { printf '%s perch-hostd: %s\n' "$(date -Is)" "$*" >&2; }

# ---------- JSON helpers (no jq: this runs before anything is installed) ----------
json_escape() {
  local s=${1-}
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  s=${s//$'\t'/\\t}
  printf '%s' "$s"
}
jstr() { printf '"%s"' "$(json_escape "${1-}")"; }
# A number, or null when the value is empty or not numeric.
jnum() { local v=${1-}; if [[ $v =~ ^-?[0-9]+([.][0-9]+)?$ ]]; then printf '%s' "$v"; else printf 'null'; fi; }

have() { command -v "$1" >/dev/null 2>&1; }

# A connection id becomes part of a unit filename and a path, so it is checked
# before it is used as either.
valid_id() { [[ ${1-} =~ ^[a-z0-9][a-z0-9-]{0,35}$ ]]; }
unit_for() { printf 'perch-tunnel-%s.service' "$1"; }

compose() {
  # Mirrors bin/perch so both take the same overlays into account — which
  # means sourcing .env and exporting COMPOSE_FILE, not just passing
  # --env-file.
  #
  # The two do different jobs and only one of them selects the overlays.
  # --env-file supplies values for interpolation *inside* the compose files;
  # the list of files itself comes from the COMPOSE_FILE variable in the
  # environment. Without it the helper sees compose.yml and nothing else, so
  # every optional service is "missing": restarting whisper answers
  # "missing services [whisper]", `containers.stop` stops perch and ollama and
  # silently leaves dictation running, and a container the console said it had
  # restarted was never touched.
  #
  # And it runs the work as a transient systemd service rather than as a child
  # of this one.
  #
  # A container inherits the execution context of whatever created it, and this
  # unit is deliberately restricted — NoNewPrivileges, a private /home. Under
  # that, creating a container gets as far as `capset: Operation not
  # permitted`: the container is created and cannot be started, so it sits in
  # Created while the console reports the restart it asked for as done. The
  # same command from a terminal works, which is what makes it so confusing to
  # diagnose — "it works when I do it by hand".
  #
  # A transient service is started by PID 1, not by this process, so it does
  # not inherit any of that. `--scope` would not do: a scope is forked from the
  # caller and keeps its no-new-privileges bit.
  if have systemd-run; then
    systemd-run --quiet --wait --collect --pipe --service-type=exec \
      --working-directory="$PERCH_DIR" --unit="perch-compose-$$" \
      /bin/bash -c '
        set -a; [ -f ./.env ] && . ./.env; set +a
        export COMPOSE_FILE="${COMPOSE_FILE:-compose.yml}"
        exec podman-compose --env-file ./.env "$@"
      ' _ "$@" 2>&1
    return
  fi
  (
    cd "$PERCH_DIR" 2>/dev/null || { echo "no install at $PERCH_DIR"; exit 1; }
    if [ -f "$PERCH_DIR/.env" ]; then
      # shellcheck disable=SC1091
      set -a; . "$PERCH_DIR/.env"; set +a
    fi
    export COMPOSE_FILE="${COMPOSE_FILE:-compose.yml}"
    podman-compose --env-file "$PERCH_DIR/.env" "$@"
  ) 2>&1
}

# ---------- telemetry ----------

read_mem() {
  # /proc/meminfo on the host: the true totals, in kB.
  local total avail free swaptotal swapfree
  total=$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null)
  avail=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo 2>/dev/null)
  free=$(awk '/^MemFree:/{print $2}' /proc/meminfo 2>/dev/null)
  swaptotal=$(awk '/^SwapTotal:/{print $2}' /proc/meminfo 2>/dev/null)
  swapfree=$(awk '/^SwapFree:/{print $2}' /proc/meminfo 2>/dev/null)
  printf '{"totalKb":%s,"availableKb":%s,"freeKb":%s,"swapTotalKb":%s,"swapFreeKb":%s}' \
    "$(jnum "$total")" "$(jnum "$avail")" "$(jnum "$free")" "$(jnum "$swaptotal")" "$(jnum "$swapfree")"
}

read_cpu() {
  local load1 load5 load15 cores
  read -r load1 load5 load15 _ < /proc/loadavg
  cores=$(nproc 2>/dev/null || echo 1)
  printf '{"load1":%s,"load5":%s,"load15":%s,"cores":%s}' \
    "$(jnum "$load1")" "$(jnum "$load5")" "$(jnum "$load15")" "$(jnum "$cores")"
}

read_gpu() {
  # NVIDIA through nvidia-smi; AMD through the sysfs the amdgpu driver
  # exposes. Both are best effort — a box with neither reports an empty list
  # and the console simply does not draw a VRAM gauge.
  local out=""
  if have nvidia-smi; then
    local line first=1
    while IFS=, read -r name memtotal memused util temp power; do
      [ -z "${name// /}" ] && continue
      [ $first -eq 0 ] && out+=","
      first=0
      out+=$(printf '{"vendor":"nvidia","name":%s,"memTotalMb":%s,"memUsedMb":%s,"utilPct":%s,"tempC":%s,"powerW":%s}' \
        "$(jstr "$(echo "$name" | xargs)")" "$(jnum "$(echo "$memtotal" | xargs)")" "$(jnum "$(echo "$memused" | xargs)")" \
        "$(jnum "$(echo "$util" | xargs)")" "$(jnum "$(echo "$temp" | xargs)")" "$(jnum "$(echo "$power" | xargs)")")
    done < <(nvidia-smi --query-gpu=name,memory.total,memory.used,utilization.gpu,temperature.gpu,power.draw \
                        --format=csv,noheader,nounits 2>/dev/null)
  elif [ -d /sys/class/drm ]; then
    local card first=1
    for card in /sys/class/drm/card*/device; do
      [ -r "$card/mem_info_vram_total" ] || continue
      local total used util name
      total=$(( $(cat "$card/mem_info_vram_total" 2>/dev/null || echo 0) / 1048576 ))
      used=$(( $(cat "$card/mem_info_vram_used" 2>/dev/null || echo 0) / 1048576 ))
      util=$(cat "$card/gpu_busy_percent" 2>/dev/null || echo "")
      name=$(cat "$card/product_name" 2>/dev/null || echo "AMD GPU")
      [ "$total" -eq 0 ] && continue
      [ $first -eq 0 ] && out+=","
      first=0
      out+=$(printf '{"vendor":"amd","name":%s,"memTotalMb":%s,"memUsedMb":%s,"utilPct":%s,"tempC":null,"powerW":null}' \
        "$(jstr "$name")" "$(jnum "$total")" "$(jnum "$used")" "$(jnum "$util")")
    done
  fi
  printf '[%s]' "$out"
}

read_disk() {
  # Where the models actually live, which is the number that matters when a
  # pull is about to fail.
  local target="$1" line size used avail pct
  line=$(df -Pk "$target" 2>/dev/null | tail -1)
  size=$(echo "$line" | awk '{print $2}'); used=$(echo "$line" | awk '{print $3}')
  avail=$(echo "$line" | awk '{print $4}'); pct=$(echo "$line" | awk '{print $5}' | tr -d '%')
  printf '{"path":%s,"totalKb":%s,"usedKb":%s,"availableKb":%s,"usedPct":%s}' \
    "$(jstr "$target")" "$(jnum "$size")" "$(jnum "$used")" "$(jnum "$avail")" "$(jnum "$pct")"
}

# The size each container was actually created with, which is a different
# question from the size .env asks for: a limit that has been written but not
# applied shows up here as the old one, and that difference is the whole
# reason the console can say "restart to apply" rather than guessing.
#
# `podman inspect` is a good deal more expensive than `podman ps`, and this
# loop runs every second, so the answer is cached — a resource limit only
# changes when a container is recreated, and ten seconds late is not late.
declare -A CT_MEM CT_CPU
LIMITS_AT=0
refresh_limits() {
  local now; now=$(date +%s)
  [ $(( now - LIMITS_AT )) -lt 10 ] && return 0
  LIMITS_AT=$now
  have podman || return 0
  CT_MEM=(); CT_CPU=()
  local names name mem nano
  names=$(podman ps --all --format '{{.Names}}' 2>/dev/null | grep perch || true)
  [ -z "$names" ] && return 0
  while IFS='|' read -r name mem nano; do
    [ -z "$name" ] && continue
    name="${name#/}"
    CT_MEM["$name"]="$mem"
    CT_CPU["$name"]="$nano"
  done < <(printf '%s\n' "$names" | xargs -r podman inspect \
             --format '{{.Name}}|{{.HostConfig.Memory}}|{{.HostConfig.NanoCpus}}' 2>/dev/null)
}

# Nanocpus as a number of cores, or null for "no limit".
cpu_field() {
  local nano="${1:-0}"
  case "$nano" in ''|0) printf 'null'; return ;; esac
  [[ $nano =~ ^[0-9]+$ ]] || { printf 'null'; return; }
  awk -v n="$nano" 'BEGIN{printf "%.2f", n/1000000000}'
}

read_containers() {
  have podman || { printf '[]'; return; }
  refresh_limits
  local out="" first=1 name status started mem
  while IFS='|' read -r name status started; do
    [ -z "$name" ] && continue
    [ $first -eq 0 ] && out+=","
    first=0
    mem="${CT_MEM[$name]:-0}"
    [[ $mem =~ ^[0-9]+$ ]] || mem=0
    out+=$(printf '{"name":%s,"status":%s,"startedAt":%s,"memLimitBytes":%s,"cpus":%s}' \
      "$(jstr "$name")" "$(jstr "$status")" "$(jstr "$started")" \
      "$([ "$mem" = 0 ] && printf 'null' || printf '%s' "$mem")" "$(cpu_field "${CT_CPU[$name]:-0}")")
  done < <(podman ps --all --filter "label=io.podman.compose.project=perch" \
             --format '{{.Names}}|{{.Status}}|{{.StartedAt}}' 2>/dev/null)
  # podman-compose has used more than one project label over the years; fall
  # back to matching the names perch gives its own containers.
  if [ -z "$out" ]; then
    first=1
    while IFS='|' read -r name status started; do
      [ -z "$name" ] && continue
      # Only this project's own containers. podman-compose names them after
      # the project directory, so both services carry "perch" in the name —
      # matching a bare "ollama" here would report somebody else's container
      # as ours.
      case "$name" in *perch*) ;; *) continue ;; esac
      [ $first -eq 0 ] && out+=","
      first=0
      mem="${CT_MEM[$name]:-0}"
      [[ $mem =~ ^[0-9]+$ ]] || mem=0
      out+=$(printf '{"name":%s,"status":%s,"startedAt":%s,"memLimitBytes":%s,"cpus":%s}' \
        "$(jstr "$name")" "$(jstr "$status")" "$(jstr "$started")" \
        "$([ "$mem" = 0 ] && printf 'null' || printf '%s' "$mem")" "$(cpu_field "${CT_CPU[$name]:-0}")")
    done < <(podman ps --all --format '{{.Names}}|{{.Status}}|{{.StartedAt}}' 2>/dev/null)
  fi
  printf '[%s]' "$out"
}

unit_state() {
  # active/inactive/failed plus whether it starts at boot, for one unit. The
  # optional second argument is why it is not up, for the units that can say.
  local unit="$1" reason="${2-}" active enabled since
  active=$(systemctl is-active "$unit" 2>/dev/null || true)
  enabled=$(systemctl is-enabled "$unit" 2>/dev/null || true)
  since=$(systemctl show "$unit" -p ActiveEnterTimestamp --value 2>/dev/null || true)
  printf '{"unit":%s,"active":%s,"enabled":%s,"since":%s,"reason":%s}' \
    "$(jstr "$unit")" "$(jstr "${active:-unknown}")" "$(jstr "${enabled:-unknown}")" "$(jstr "$since")" \
    "$(jstr "$reason")"
}

# Why a tunnel is not up, in one word, read from its own journal.
#
# systemd has only "activating" or "failed" to offer, and Restart=always means
# a tunnel that can never work looks exactly like one that is about to. The
# two failures that actually happen both follow an ssh key being replaced at
# one end or the other, and neither clears itself:
#
#   host-key-changed  the far side was rebuilt, so its host key is not the one
#                     in known_hosts. accept-new accepts a *first* key, never a
#                     changed one — which is what makes it safe and also what
#                     leaves this stuck until somebody says the new key is real.
#   key-rejected      this end's key is not in the far side's authorized_keys.
#                     Usually a key regenerated here after setup was run there.
#
# Neither is guessed at from the exit status. ssh says both of these plainly,
# so the journal is read rather than divined.
tunnel_reason() {
  local unit="$1" log
  log=$(journalctl -u "$unit" -n 40 --no-pager 2>/dev/null) || return 0
  case "$log" in
    *"REMOTE HOST IDENTIFICATION HAS CHANGED"*|*"Host key verification failed"*)
      printf 'host-key-changed' ;;
    *"denied (publickey"*|*"Permission denied, please try again"*)
      printf 'key-rejected' ;;
    *"remote port forwarding failed"*)
      printf 'forward-refused' ;;
    *"Could not resolve hostname"*)
      printf 'host-unknown' ;;
    *"Connection refused"*|*"Connection timed out"*|*"No route to host"*|*"Operation timed out"*)
      printf 'unreachable' ;;
    *) printf '' ;;
  esac
}

# Every connection has its own unit, so the console is told about all of them
# rather than about one. Units are found on disk rather than asked of systemd,
# so a unit that exists but has never been started still shows up.
read_tunnels() {
  local out="" first=1 f unit reason
  for f in /etc/systemd/system/perch-tunnel-*.service; do
    [ -e "$f" ] || continue
    unit="$(basename "$f")"
    [ $first -eq 0 ] && out+=","
    first=0
    # The journal is only read for a tunnel that is not up. A healthy one is
    # the common case and this runs on every status poll.
    reason=""
    [ "$(systemctl is-active "$unit" 2>/dev/null)" = active ] || reason="$(tunnel_reason "$unit")"
    out+="$(unit_state "$unit" "$reason")"
  done
  printf '[%s]' "$out"
}

write_status() {
  local tmp="$STATUS.tmp"
  {
    printf '{'
    printf '"at":%s,' "$(jstr "$(date -Is)")"
    printf '"hostname":%s,' "$(jstr "$(hostname 2>/dev/null)")"
    printf '"kernel":%s,' "$(jstr "$(uname -r 2>/dev/null)")"
    printf '"uptimeSeconds":%s,' "$(jnum "$(awk '{printf "%d", $1}' /proc/uptime 2>/dev/null)")"
    printf '"mem":%s,' "$(read_mem)"
    printf '"cpu":%s,' "$(read_cpu)"
    printf '"gpus":%s,' "$(read_gpu)"
    printf '"disk":%s,' "$(read_disk "$STATE_DIR")"
    printf '"containers":%s,' "$(read_containers)"
    printf '"boot":%s,' "$(unit_state perch.service)"
    printf '"tunnels":%s,' "$(read_tunnels)"
    printf '"hostd":{"version":"0.1.0","interval":%s}' "$(jnum "$INTERVAL")"
    printf '}\n'
  } > "$tmp" 2>/dev/null
  mv -f "$tmp" "$STATUS" 2>/dev/null && chmod 644 "$STATUS" 2>/dev/null
}

# ---------- actions ----------

# Only these names do anything. Anything else is refused and logged.
run_action() {
  local action="$1" arg="${2-}"
  case "$action" in
    containers.start)    compose up -d ;;
    containers.stop)     compose down ;;
    # A restart is a restart: the same container, started again. It does not
    # re-read .env — compose fixes a container's environment when it *creates*
    # it — so nothing that applies a setting may ask for this. Four of the six
    # services used to be quietly recreated here instead, which made "restart"
    # mean one thing for whisper and another for Ollama, and left the callers
    # that needed a recreate looking as though a restart were enough. They ask
    # for containers.recreate now, and this does what its name says.
    containers.restart)
      case "$arg" in
        ''|all)      compose restart ;;
        perch|ollama|whisper|comfy|kokoro) compose restart "$arg" ;;
        *)           echo "unknown service: $arg"; return 2 ;;
      esac ;;
    # Both a resource limit and a tuning value are fixed when a container is
    # created, so applying either is a recreate — a restart would leave the
    # new value sitting in .env doing nothing, which is the worst way for a
    # setting to fail.
    containers.recreate)
      case "$arg" in
        perch|ollama|whisper|comfy|kokoro) compose up -d --force-recreate "$arg" ;;
        ''|all)      compose up -d --force-recreate ;;
        *)           echo "unknown service: $arg"; return 2 ;;
      esac ;;
    containers.pull)     compose pull ;;
    boot.enable)         systemctl enable perch.service 2>&1 ;;
    boot.disable)        systemctl disable perch.service 2>&1 ;;
    tunnel.start|tunnel.stop|tunnel.restart|tunnel.enable|tunnel.disable|tunnel.logs)
      valid_id "$arg" || { echo "bad connection id"; return 2; }
      case "$action" in
        tunnel.start)   systemctl start "$(unit_for "$arg")" 2>&1 ;;
        tunnel.stop)    systemctl stop "$(unit_for "$arg")" 2>&1 ;;
        tunnel.restart) systemctl restart "$(unit_for "$arg")" 2>&1 ;;
        tunnel.enable)  systemctl enable --now "$(unit_for "$arg")" 2>&1 ;;
        tunnel.disable) systemctl disable --now "$(unit_for "$arg")" 2>&1 ;;
        tunnel.logs)    journalctl -u "$(unit_for "$arg")" -n 100 --no-pager 2>&1 ;;
      esac ;;
    tunnel.hostkey)      do_tunnel_hostkey "$arg" ;;
    tunnel.rehost)       do_tunnel_rehost "$arg" ;;
    tunnel.keygen)       do_keygen "$arg" ;;
    tunnel.configure)    do_tunnel_configure "$arg" ;;
    tunnel.remove)       do_tunnel_remove "$arg" ;;
    logs)
      case "$arg" in
        # whisper's log is where a first start's model download is visible;
        # nothing else reports that progress at all. ComfyUI's is where a
        # workflow that failed for want of a model file says so.
        perch|ollama|whisper|comfy|kokoro) compose logs --tail=200 "$arg" ;;
        *)               echo "unknown service: $arg"; return 2 ;;
      esac ;;
    env.set)             do_env_set "$arg" ;;
    env.get)             do_env_get "$arg" ;;
    env.tuning)          do_env_tuning ;;
    whisper.model)       do_whisper_model ;;
    daemon.reload)       systemctl daemon-reload 2>&1 ;;
    *)
      echo "refused: $action is not an action perch-hostd performs"
      return 2 ;;
  esac
}

# A dedicated key per connection, generated on this box and never leaving it.
# Per connection rather than shared, so retiring one cannot strand another and
# a key that leaks is good for exactly one machine.
# Read the host and ssh port a connection was configured with. Both actions
# below need them and neither should trust an argument for it.
tunnel_endpoint() {
  local id="$1" conf="$STATE_DIR/tunnels/$1.conf" k v
  [ -f "$conf" ] || { echo "no configuration for $id yet" >&2; return 1; }
  TE_HOST=""; TE_PORT=""
  while IFS='=' read -r k v; do
    case "$k" in HOST) TE_HOST="$v" ;; SSH_PORT) TE_PORT="$v" ;; esac
  done < "$conf"
  [[ $TE_HOST =~ ^[A-Za-z0-9._-]{1,253}$ ]] || { echo "bad host" >&2; return 2; }
  [[ $TE_PORT =~ ^[0-9]{1,5}$ ]] || TE_PORT=22
  return 0
}

# What host key the far side is offering now, and what is on file for it.
#
# This is the half that makes accepting a changed key an informed decision
# rather than a blind one. A changed host key is what a rebuilt server looks
# like; it is also what a machine-in-the-middle looks like, and nothing here
# can tell the two apart. Only somebody who can check the fingerprint against
# the far side can, so the console shows both and asks.
do_tunnel_hostkey() {
  local id="$1"
  valid_id "$id" || { echo "bad connection id"; return 2; }
  tunnel_endpoint "$id" || return $?
  local kh="$STATE_DIR/ssh/$id/known_hosts"
  echo "host: $TE_HOST:$TE_PORT"
  echo "offered now:"
  ssh-keyscan -T 10 -p "$TE_PORT" "$TE_HOST" 2>/dev/null | ssh-keygen -lf - 2>/dev/null \
    | sed 's/^/  /' || echo "  (could not reach it)"
  echo "on file:"
  if [ -s "$kh" ]; then
    ssh-keygen -lf "$kh" 2>/dev/null | sed 's/^/  /' || echo "  (unreadable)"
  else
    echo "  (nothing yet)"
  fi
}

# Forget the host key on file so the next connection learns the current one.
#
# Only ever run because somebody asked for it after seeing both fingerprints.
# StrictHostKeyChecking=accept-new will take a first key on its own but never
# a replacement, which is the behaviour worth keeping — so this removes the
# old entry rather than weakening the option.
do_tunnel_rehost() {
  local id="$1"
  valid_id "$id" || { echo "bad connection id"; return 2; }
  tunnel_endpoint "$id" || return $?
  local kh="$STATE_DIR/ssh/$id/known_hosts"
  [ -f "$kh" ] || { echo "no known_hosts for $id yet; nothing to forget"; return 0; }
  # ssh writes "[host]:port" when the port is not 22 and a bare host when it
  # is. Which one is on file depends on how the connection was configured, so
  # both are removed.
  ssh-keygen -R "$TE_HOST" -f "$kh" >/dev/null 2>&1 || true
  ssh-keygen -R "[$TE_HOST]:$TE_PORT" -f "$kh" >/dev/null 2>&1 || true
  rm -f "$kh.old"
  # ssh-keygen -R rewrites the file, so the tunnel account has to be given it
  # back or the next connection cannot read its own known_hosts.
  chown "$TUNNEL_USER" "$kh" 2>/dev/null || true
  chmod 600 "$kh" 2>/dev/null || true
  systemctl restart "$(unit_for "$id")" 2>&1 || true
  echo "forgot the old host key for $TE_HOST; the tunnel will learn the current one when it reconnects"
}

do_keygen() {
  local id="$1"
  valid_id "$id" || { echo "bad connection id"; return 2; }
  local dir="$STATE_DIR/ssh/$id" key="$STATE_DIR/ssh/$id/id_ed25519"
  mkdir -p "$dir"
  # 711, not 700, on both this directory and its parent.
  #
  # The private key is 600 and owned by the tunnel account, which is what keeps
  # it secret. But the console — running in a container as a different uid —
  # has to read the *public* key back to show it to you, and a 700 directory
  # blocks that before file permissions are even consulted: the key generates
  # fine and then cannot be read, which is a confusing way to fail.
  #
  # 711 lets another uid traverse to a path it already knows without being able
  # to list the directory, and the private key stays unreadable to it.
  # Every level has to be traversable by the tunnel account, which owns the
  # keys but owns none of the directories above them.
  chmod 711 "$STATE_DIR" 2>/dev/null || true
  chmod 711 "$STATE_DIR/ssh" 2>/dev/null || true
  chmod 711 "$dir"

  # An install that predates per-connection keys has one at the old shared
  # path. Move it in rather than generating a second key the far side has
  # never been told about.
  if [ ! -f "$key" ] && [ "$id" = default ] && [ -f "$STATE_DIR/ssh/id_ed25519" ]; then
    mv "$STATE_DIR/ssh/id_ed25519" "$key" 2>/dev/null || true
    mv "$STATE_DIR/ssh/id_ed25519.pub" "$key.pub" 2>/dev/null || true
    echo "adopted the existing key from before connections were separate"
  fi

  if [ ! -f "$key" ]; then
    ssh-keygen -t ed25519 -N '' -C "perch-$id@$(hostname 2>/dev/null || echo host)" -f "$key" >/dev/null 2>&1 || {
      echo "ssh-keygen failed"; return 1; }
  fi
  chmod 600 "$key"; chmod 644 "$key.pub"
  if id "$TUNNEL_USER" >/dev/null 2>&1; then
    chown -R "$TUNNEL_USER" "$dir" 2>/dev/null || true
    touch "$dir/known_hosts"; chown "$TUNNEL_USER" "$dir/known_hosts" 2>/dev/null || true
    chmod 600 "$dir/known_hosts" 2>/dev/null || true
  fi
  cat "$key.pub"
}

# Rewrite the tunnel unit from the settings the console saved, then reload
# systemd and restart the tunnel if it was already running.
#
# The console writes tunnel.conf rather than passing these as arguments: they
# are six related values that must be validated together, and a config file
# both sides can read beats six chances to get an argument wrong.
do_tunnel_configure() {
  local id="$1"
  valid_id "$id" || { echo "bad connection id"; return 2; }
  local conf="$STATE_DIR/tunnels/$id.conf" tmpl="$PERCH_DIR/deploy/perch-tunnel.service.tmpl"
  local unit; unit="/etc/systemd/system/$(unit_for "$id")"
  [ -f "$conf" ] || { echo "no configuration for $id yet"; return 1; }
  [ -f "$tmpl" ] || { echo "missing $tmpl"; return 1; }
  local HOST="" USER="" SSH_PORT="" REMOTE_BIND="" REMOTE_PORT="" LOCAL_PORT="" TOR_PROXY="" FORWARDS=""
  while IFS='=' read -r k v; do
    case "$k" in
      HOST) HOST="$v" ;; USER) USER="$v" ;; SSH_PORT) SSH_PORT="$v" ;;
      REMOTE_BIND) REMOTE_BIND="$v" ;; REMOTE_PORT) REMOTE_PORT="$v" ;; LOCAL_PORT) LOCAL_PORT="$v" ;;
      TOR_PROXY) TOR_PROXY="$v" ;; FORWARDS) FORWARDS="$v" ;;
    esac
  done < "$conf"

  # Validated here as well as in the console, because this is the side that
  # writes a root-owned unit file and runs what is in it.
  # Matches .onion addresses too: 56 base32 characters plus ".onion" is well
  # inside this, and the charset is the same.
  [[ $HOST =~ ^[A-Za-z0-9._-]{1,253}$ ]] || { echo "bad host"; return 2; }
  [[ $USER =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || { echo "bad user"; return 2; }
  [[ $SSH_PORT =~ ^[0-9]{1,5}$ ]] || { echo "bad ssh port"; return 2; }
  [[ $REMOTE_PORT =~ ^[0-9]{1,5}$ ]] || { echo "bad remote port"; return 2; }
  [[ $LOCAL_PORT =~ ^[0-9]{1,5}$ ]] || { echo "bad local port"; return 2; }
  [[ $REMOTE_BIND =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || { echo "bad remote bind"; return 2; }
  # The same rail as the far-side script: a public bind address would put the
  # model endpoint on the internet.
  case "$REMOTE_BIND" in
    127.*|10.*|192.168.*|169.254.*) ;;
    172.1[6-9].*|172.2[0-9].*|172.3[01].*) ;;
    *) echo "refusing to bind $REMOTE_BIND: not a private address"; return 2 ;;
  esac

  # One -R per forwarded service. Every port is checked before it becomes part
  # of a root-owned unit file; anything that is not a pair of plain numbers is
  # refused rather than passed through.
  local forward_opts="" pair lp rp
  [ -n "$FORWARDS" ] || FORWARDS="$LOCAL_PORT:$REMOTE_PORT"
  local IFS_SAVE="$IFS"; IFS=','
  for pair in $FORWARDS; do
    lp="${pair%%:*}"; rp="${pair##*:}"
    [[ $lp =~ ^[0-9]{1,5}$ && $rp =~ ^[0-9]{1,5}$ ]] || { IFS="$IFS_SAVE"; echo "bad forward: $pair"; return 2; }
    forward_opts+=" -R $REMOTE_BIND:$rp:127.0.0.1:$lp"
  done
  IFS="$IFS_SAVE"
  [ -n "$forward_opts" ] || { echo "no forwards configured"; return 2; }

  local runas="$TUNNEL_USER"
  id "$runas" >/dev/null 2>&1 || runas=root
  local key="$STATE_DIR/ssh/$id/id_ed25519"
  [ -f "$key" ] || { echo "no key for $id yet; generate one first"; return 1; }

  # Dialling out through a SOCKS proxy — Tor, in practice. netcat does the
  # SOCKS5 handshake and hands the hostname to the proxy rather than resolving
  # it here: that is both what stops a DNS leak and what makes an .onion work
  # at all, since no DNS can answer for one.
  #
  # %%h and %%p are escaped systemd specifiers; see the template. Getting that
  # wrong is silent — ssh is handed the wrong host and port.
  local proxy_opt alive connect_timeout restart_sec
  if [ -n "$TOR_PROXY" ]; then
    [[ $TOR_PROXY =~ ^[0-9.]{7,15}:[0-9]{1,5}$ ]] || { echo "bad SOCKS proxy address"; return 2; }
    case "$TOR_PROXY" in
      127.*|10.*|192.168.*) ;;
      172.1[6-9].*|172.2[0-9].*|172.3[01].*) ;;
      *) echo "refusing a SOCKS proxy that is not on this machine or your own network"; return 2 ;;
    esac
    command -v nc >/dev/null 2>&1 || { echo "netcat (nc) is needed to dial through a SOCKS proxy"; return 1; }
    proxy_opt="-o \"ProxyCommand=$(command -v nc) -X 5 -x $TOR_PROXY %%h %%p\""
    # Tor takes its time: a circuit is seconds, a hidden service can be most of
    # a minute, and every reconnection pays it again.
    alive=60; connect_timeout=120; restart_sec=30
  else
    proxy_opt="-o TCPKeepAlive=yes"
    alive=30; connect_timeout=15; restart_sec=5
  fi

  sed -e "s|__ID__|$id|g" -e "s|__USER__|$USER|g" -e "s|__HOST__|$HOST|g" -e "s|__SSH_PORT__|$SSH_PORT|g" \
      -e "s|__REMOTE_BIND__|$REMOTE_BIND|g" -e "s|__REMOTE_PORT__|$REMOTE_PORT|g" \
      -e "s|__LOCAL_PORT__|$LOCAL_PORT|g" -e "s|__KEY_PATH__|$key|g" \
      -e "s|__FORWARDS__|${forward_opts# }|g" \
      -e "s|__KEY_DIR__|$STATE_DIR/ssh/$id|g" -e "s|__RUNAS__|$runas|g" \
      -e "s|__PROXY_OPT__|$proxy_opt|g" -e "s|__ALIVE_INTERVAL__|$alive|g" \
      -e "s|__CONNECT_TIMEOUT__|$connect_timeout|g" -e "s|__RESTART_SEC__|$restart_sec|g" \
      "$tmpl" > "$unit" || { echo "could not write $unit"; return 1; }
  chmod 644 "$unit"

  # An install from before connections were separate has a single unnamed
  # unit. Retire it once its replacement exists, or two tunnels fight over the
  # same remote port and neither wins.
  if [ "$id" = default ] && [ -f /etc/systemd/system/perch-tunnel.service ]; then
    systemctl disable --now perch-tunnel.service >/dev/null 2>&1 || true
    rm -f /etc/systemd/system/perch-tunnel.service
    echo "replaced the single-tunnel unit from the previous layout"
  fi

  systemctl daemon-reload 2>&1
  if [ "$(systemctl is-active "$(unit_for "$id")" 2>/dev/null)" = active ]; then
    systemctl restart "$(unit_for "$id")" 2>&1
    echo "$id reconfigured and restarted"
  else
    echo "$id reconfigured (not running)"
  fi
}

# Take a connection down completely on this machine: unit stopped, disabled and
# deleted, key and configuration removed.
#
# What it does NOT do is touch the far side. The tunnel key is restricted with
# command="/usr/sbin/nologin" so it cannot run anything over there, which is
# the point of it — a credential here that could clean up remotely could also
# do everything else. The console shows the command to run instead.
#
# Idempotent: everything is guarded, so removing something already removed
# succeeds quietly.
do_tunnel_remove() {
  local id="$1"
  valid_id "$id" || { echo "bad connection id"; return 2; }
  local unit; unit="$(unit_for "$id")"
  systemctl disable --now "$unit" >/dev/null 2>&1 || true
  rm -f "/etc/systemd/system/$unit"
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl reset-failed "$unit" >/dev/null 2>&1 || true
  # The key goes with it. Keeping it would leave a credential for a machine
  # perch no longer talks to.
  rm -rf "${STATE_DIR:?}/ssh/$id"
  rm -f "${STATE_DIR:?}/tunnels/$id.conf"
  echo "removed $id from this machine"
}

# Ollama's tuning knobs, the speech model and the container sizes, written
# into .env so they survive a restart. Only these keys, and only values of the
# shape each one takes — the file is read by compose, so an unchecked value
# here would be an injection into the container's environment.
do_env_set() {
  local key="${1%%=*}" value="${1#*=}"
  case "$key" in
    OLLAMA_NUM_PARALLEL|OLLAMA_MAX_LOADED_MODELS|OLLAMA_MAX_QUEUE)
      [[ $value =~ ^[0-9]{1,4}$ ]] || { echo "bad value for $key"; return 2; } ;;
    OLLAMA_KV_CACHE_TYPE)
      case "$value" in f16|q8_0|q4_0) ;; *) echo "bad value for $key"; return 2 ;; esac ;;
    OLLAMA_FLASH_ATTENTION)
      case "$value" in 0|1) ;; *) echo "bad value for $key"; return 2 ;; esac ;;
    OLLAMA_KEEP_ALIVE)
      [[ $value =~ ^-?[0-9]+[smh]?$ ]] || { echo "bad value for $key"; return 2; } ;;
    PERCH_MAX_CONCURRENT)
      [[ $value =~ ^[0-9]+[mg]?$ ]] || { echo "bad value for $key"; return 2; } ;;
    # How big each container may be. A memory limit as compose writes it —
    # 512m, 8g, or 0 for no limit — and a CPU limit in cores, which may have a
    # fraction. Both go straight into a `podman create` argument, so the shape
    # is checked here as well as in the console.
    PERCH_MEM_LIMIT|OLLAMA_MEM_LIMIT|WHISPER_MEM_LIMIT|COMFY_MEM_LIMIT|KOKORO_MEM_LIMIT)
      [[ $value =~ ^[0-9]{1,6}[kmgKMG]?$ ]] || { echo "bad value for $key"; return 2; } ;;
    PERCH_CPUS|OLLAMA_CPUS|WHISPER_CPUS|COMFY_CPUS|KOKORO_CPUS)
      [[ $value =~ ^[0-9]{1,3}(\.[0-9]{1,2})?$ ]] || { echo "bad value for $key"; return 2; } ;;
    # The speech model. A literal list rather than a pattern: the value
    # becomes part of a filename inside the container's start command
    # (ggml-$WHISPER_MODEL.bin), so anything not on this list has no business
    # being written into the environment compose expands.
    WHISPER_MODEL)
      case "$value" in
        tiny|tiny.en|base|base.en|small|small.en|medium|medium.en|large-v2|large-v3|large-v3-turbo) ;;
        *) echo "bad value for $key"; return 2 ;;
      esac ;;
    *) echo "refused: $key is not a settable key"; return 2 ;;
  esac
  local env_file="$PERCH_DIR/.env"
  [ -f "$env_file" ] || { echo "no .env at $env_file"; return 1; }
  if grep -q "^$key=" "$env_file" 2>/dev/null; then
    sed -i "s|^$key=.*|$key=$value|" "$env_file"
  else
    printf '%s=%s\n' "$key" "$value" >> "$env_file"
  fi
  echo "set $key=$value (the container has to be recreated to pick it up)"
}

# Which weights the whisper container is actually running.
#
# Not the same question as "what does .env ask for": those differ whenever a
# change has been written and not applied, which is the state a failed switch
# leaves behind. The console cannot answer it alone — it has no view of the
# container's command line, and whisper.cpp does not report its own model — so
# without this the card has to guess, and guesses wrong in exactly the case
# somebody is trying to diagnose.
do_whisper_model() {
  have podman || { echo "podman is not here"; return 1; }
  local name cmd
  name=$(podman ps --all --format '{{.Names}}' 2>/dev/null | grep -m1 -E '(^|[_-])whisper([_-]|$)') || true
  [ -n "$name" ] || { echo ""; return 0; }
  cmd=$(podman inspect "$name" --format '{{range .Config.Cmd}}{{.}} {{end}}' 2>/dev/null) || true
  printf '%s\n' "$cmd" | grep -oE 'ggml-[A-Za-z0-9.-]+\.bin' | head -1 | sed -e 's/^ggml-//' -e 's/\.bin$//'
}

# The tuning keys, grouped by the container that reads each one. The console
# has its own copy of this in server/src/containers.ts; this is the one with
# root behind it, so it is the one that decides.
OLLAMA_TUNING_KEYS=(OLLAMA_NUM_PARALLEL OLLAMA_MAX_LOADED_MODELS OLLAMA_MAX_QUEUE
                    OLLAMA_KV_CACHE_TYPE OLLAMA_FLASH_ATTENTION OLLAMA_KEEP_ALIVE)
PERCH_TUNING_KEYS=(PERCH_MAX_CONCURRENT)

# One of this project's containers, by its compose service name.
#
# The compose labels are the reliable answer where podman-compose sets them.
# The fallback is the name it builds, <project>_<service>_<index>, matched on a
# field other than the first — "perch" is both the project and a service, so a
# first-field match would hand back perch_ollama_1 when asked for perch.
compose_container() {
  local svc="$1" n
  n=$(podman ps --all --filter "label=io.podman.compose.project=perch" \
        --filter "label=io.podman.compose.service=$svc" --format '{{.Names}}' 2>/dev/null | head -1)
  [ -n "$n" ] && { printf '%s\n' "$n"; return 0; }
  podman ps --all --format '{{.Names}}' 2>/dev/null \
    | awk -F'[-_]' -v s="$svc" '/perch/ { for (i = 2; i <= NF; i++) if ($i == s) { print; exit } }'
}

# What one container was actually created with, for the keys it reads.
tuning_running() {
  local svc="$1"; shift
  local name pattern="" key
  name=$(compose_container "$svc")
  [ -n "$name" ] || return 0
  for key in "$@"; do pattern+="${pattern:+|}$key"; done
  podman inspect "$name" --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null \
    | grep -E "^($pattern)=" \
    | while IFS= read -r line; do printf '%s\t%s\n' "$svc" "$line"; done
}

# Every tuning key twice over: what .env asks for, and what the container that
# reads it is actually running with.
#
# The gap between those two is the whole point. A value written and not yet
# applied shows up here as an `env` line that its container's line disagrees
# with — which is the state the console has to be able to draw, because it is
# the state somebody is in when they say a setting did nothing. Neither answer
# can be had from inside a container: .env is on the host, and no container can
# read another's environment.
#
# One action rather than one per key. Every request is a file written, a poll
# and a file read; seven of those to fill one card is a pause you can see.
do_env_tuning() {
  local key value
  if [ -f "$PERCH_DIR/.env" ]; then
    for key in "${OLLAMA_TUNING_KEYS[@]}" "${PERCH_TUNING_KEYS[@]}"; do
      value=$(sed -n "s/^$key=//p" "$PERCH_DIR/.env" | tail -1)
      [ -n "$value" ] && printf 'env\t%s=%s\n' "$key" "$value"
    done
  fi
  have podman || return 0
  tuning_running ollama "${OLLAMA_TUNING_KEYS[@]}"
  tuning_running perch "${PERCH_TUNING_KEYS[@]}"
  return 0
}

# Read one of the settable keys back.
#
# The console has no copy of .env and cannot read the host's filesystem. What
# it has is the environment compose handed its own container when that
# container was created — which is right until somebody changes a setting
# without recreating perch as well, and then it is a confident lie: the speech
# model is switched, whisper comes back on the new weights, and the card goes
# on naming the old one.
do_env_get() {
  local key="${1%%=*}"
  case "$key" in
    OLLAMA_NUM_PARALLEL|OLLAMA_MAX_LOADED_MODELS|OLLAMA_MAX_QUEUE|OLLAMA_KV_CACHE_TYPE) ;;
    OLLAMA_FLASH_ATTENTION|OLLAMA_KEEP_ALIVE|PERCH_MAX_CONCURRENT|WHISPER_MODEL) ;;
    PERCH_MEM_LIMIT|OLLAMA_MEM_LIMIT|WHISPER_MEM_LIMIT|COMFY_MEM_LIMIT|KOKORO_MEM_LIMIT) ;;
    PERCH_CPUS|OLLAMA_CPUS|WHISPER_CPUS|COMFY_CPUS|KOKORO_CPUS) ;;
    *) echo "refused: $key is not a readable key"; return 2 ;;
  esac
  [ -f "$PERCH_DIR/.env" ] || { echo "no .env at $PERCH_DIR"; return 1; }
  # The last assignment wins, which is what a shell sourcing the file would do.
  sed -n "s/^$key=//p" "$PERCH_DIR/.env" | tail -1
}

process_requests() {
  local f id action arg out rc
  for f in "$REQ_DIR"/*.req; do
    [ -e "$f" ] || continue
    id=$(basename "$f" .req)
    # An id has to look like an id: it becomes a filename in the results
    # directory, and "../" in it would be a path traversal handed to root.
    if ! [[ $id =~ ^[A-Za-z0-9_-]{6,64}$ ]]; then log "bad request id, dropping"; rm -f "$f"; continue; fi
    action=""; arg=""
    while IFS='=' read -r k v; do
      case "$k" in action) action="$v" ;; arg) arg="$v" ;; esac
    done < "$f"
    rm -f "$f"
    # Actions and arguments are drawn from a fixed vocabulary; anything with a
    # shell metacharacter in it never had a chance of being valid.
    if ! [[ $action =~ ^[a-z]+(\.[a-z]+)?$ ]]; then
      printf '{"id":%s,"ok":false,"code":2,"output":"malformed action"}\n' "$(jstr "$id")" > "$RES_DIR/$id.json"
      continue
    fi
    if [ -n "$arg" ] && ! [[ $arg =~ ^[A-Za-z0-9_=.:/-]{0,120}$ ]]; then
      printf '{"id":%s,"ok":false,"code":2,"output":"malformed argument"}\n' "$(jstr "$id")" > "$RES_DIR/$id.json"
      continue
    fi
    log "action $action ${arg:+($arg)}"
    out=$(run_action "$action" "$arg" 2>&1); rc=$?
    out=$(printf '%s' "$out" | tr -d '\000-\010\013\014\016-\037' | tail -c 60000)
    printf '{"id":%s,"ok":%s,"code":%s,"at":%s,"output":%s}\n' \
      "$(jstr "$id")" "$([ $rc -eq 0 ] && echo true || echo false)" "$rc" "$(jstr "$(date -Is)")" "$(jstr "$out")" \
      > "$RES_DIR/$id.json"
    chmod 644 "$RES_DIR/$id.json" 2>/dev/null
  done
  # Results are picked up within a second or two; anything still here after a
  # couple of minutes was abandoned.
  find "$RES_DIR" -type f -mmin +2 -delete 2>/dev/null || true
}

log "started (state=$STATE_DIR project=$PERCH_DIR interval=${INTERVAL}s)"
trap 'log "stopping"; exit 0' TERM INT

while true; do
  write_status
  process_requests
  sleep "$INTERVAL"
done
